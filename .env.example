# =====================================================================
# JCL Studio AI — Environment Configuration Template
# Copy this file to .env and configure your production or local secrets.
# DO NOT commit real API keys or .env files to source control!
# =====================================================================

# LLM Provider Selection: 'openai' (default) or 'gemini'
LLM_PROVIDER=openai

# OpenAI Configuration (Default Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Google Gemini Configuration (Optional Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server & Network Configuration (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DOCS_ENABLED=false

# Cross-Origin Resource Sharing (CORS)
# Set to your GitHub Pages URL (e.g. https://your-username.github.io)
# Comma-separated list for multiple origins
ALLOWED_ORIGINS=https://your-username.github.io,http://localhost:8000,http://127.0.0.1:8000

# Public API Security & Access Control
# Set a shared studio access key to protect paid AI generation endpoints
STUDIO_API_KEY=your_secure_studio_access_key_here

# Rate Limiting & Spend Guardrails
RATE_LIMIT_PER_MINUTE=30
DAILY_SPEND_LIMIT_USD=5.00
